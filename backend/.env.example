# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=parfum_db

# --- Auth ---
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_random_bytes_64_hex_here

# --- Server ---
PORT=3000
# Pisahkan dengan koma jika lebih dari satu origin
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# production menonaktifkan sync({ alter: true })
NODE_ENV=development

# --- Seeder ---
# Dipakai saat menjalankan: npm run seed
ADMIN_EMAIL=admin@ask.com
ADMIN_PASSWORD=change_me_strong_password
